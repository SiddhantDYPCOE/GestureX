
{
  "manifest_version": 3,
  "name": "GestureX",
  "version": "1.0.0",
  "description": "Control your browser using hand gestures and your webcam.",

  "minimum_chrome_version": "116",

  "permissions": [
    "storage",
    "tabs",
    "offscreen"
  ],

  "host_permissions": [
    "<all_urls>"
  ],
"content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
},
  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "keyboard.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "models/hand_landmarker.task",
        "mediapipe/wasm/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "action": {
    "default_title": "Open GestureX"
  }
}
